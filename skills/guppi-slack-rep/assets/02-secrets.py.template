"""One-time: load the Slack tokens from local files into Snowflake SECRET objects.

RECIPE TEMPLATE — substitute {{TOKENS}}.

Reads local token files (default /tmp/bot.txt = xoxb, /tmp/app.txt = xapp), creates
two GENERIC_STRING secrets, and grants READ to the bridge role. The token values are
read in-process and never appear in chat, shell history, or tool args.

Run:  SNOWFLAKE_CONNECTION_NAME={{CONNECTION}} python3 create_secrets.py
Then DELETE the local token files.
"""
import snowflake.connector

BOT = open("/tmp/bot.txt").read().strip()
APP = open("/tmp/app.txt").read().strip()
assert BOT.startswith("xoxb-"), "bot token should start with xoxb-"
assert APP.startswith("xapp-"), "app-level token should start with xapp-"

conn = snowflake.connector.connect(connection_name="{{CONNECTION}}")
try:
    cur = conn.cursor()
    for name, val in (("SLACK_BOT_TOKEN", BOT), ("SLACK_APP_TOKEN", APP)):
        cur.execute(
            f"CREATE OR REPLACE SECRET {{DB}}.{{SCHEMA}}.{name} "
            f"TYPE = GENERIC_STRING SECRET_STRING = '{val}'"
        )
        cur.execute(
            f"GRANT READ ON SECRET {{DB}}.{{SCHEMA}}.{name} TO ROLE {{ROLE}}"
        )
        print(f"stored + granted: {name}")
    print("done — now delete /tmp/bot.txt and /tmp/app.txt")
finally:
    conn.close()
