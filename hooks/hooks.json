{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/lifecycle.sh session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|multi_edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/lifecycle.sh pre-write",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/lifecycle.sh post-skill",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/lifecycle.sh stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
